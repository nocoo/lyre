{
	"name": "lyre",
	"version": "2.1.5",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.22.0 || ^24.0.0 || >=26.0.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run web:dev",
		"dev:all": "bun run worker:dev & bun run web:dev",
		"build": "bun run web:build",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:macos": "bun run scripts/test-macos.ts",
		"test:macos:live": "bun run scripts/test-macos.ts --live",
		"typecheck": "bun run web:typecheck && bun run worker:typecheck && bun run api:typecheck",
		"deploy": "bun run web:build && bun run --cwd apps/api deploy",
		"web:dev": "bun run --cwd apps/web dev",
		"web:build": "bun run --cwd apps/web build",
		"web:typecheck": "bun run --cwd apps/web typecheck",
		"worker:dev": "bun run --cwd apps/api dev",
		"worker:typecheck": "bun run --cwd apps/api typecheck",
		"api:typecheck": "bun run --cwd packages/api typecheck",
		"test:e2e": "bun run scripts/run-e2e.ts",
		"test:e2e:bdd": "npx playwright test",
		"gate:routes": "bun run scripts/check-route-coverage.ts",
		"gate:pages": "bun run scripts/check-page-coverage.ts",
		"gate:secrets": "bun run scripts/gate-secrets.ts",
		"gate:deps": "bun run scripts/gate-deps.ts",
		"pre-push": "bun run scripts/pre-push.ts",
		"prepare": "husky",
		"release": "bun run scripts/release.ts",
		"macos:dmg": "bash scripts/build-dmg.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "1.64.1",
		"@types/better-sqlite3": "9.6.0",
		"@vitest/coverage-v8": "5.0.5",
		"better-sqlite3": "13.0.3",
		"husky": "^9.1.7",
		"vitest": "5.0.5"
	},
	"overrides": {
		"ws": "^8.21.0",
		"esbuild": "^0.28.1",
		"@babel/core": "^7.29.6",
		"js-yaml": "^4.2.0",
		"undici": "^7.29.1",
		"zod": "^4.6.6",
		"vite": "8.3.5",
		"postcss": "^8.5.23",
		"sharp": "0.35.5",
		"@ai-sdk/anthropic": {
			"@ai-sdk/provider-utils": "5.0.1"
		},
		"@ai-sdk/openai": {
			"@ai-sdk/provider-utils": "5.0.1"
		},
		"browserslist": "^4.28.7",
		"nanoid": "^3.3.18",
		"source-map-js": "^1.2.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"better-sqlite3",
		"husky"
	]
}
