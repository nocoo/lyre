{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noNodejsModules": "off",
				"useImportExtensions": "off",
				"noUndeclaredDependencies": "off",
				"noUndeclaredVariables": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useNamingConvention": "off",
				"noDefaultExport": "off",
				"useFilenamingConvention": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["next", "next/*", "next-auth", "next-auth/*", "next-themes"],
								"message": "Next.js / NextAuth / next-themes are not part of this stack."
							}
						]
					}
				}
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off"
			},
			"suspicious": {
				"noConsole": "off",
				"noReactSpecificProps": "off",
				"useAwait": "off",
				"noExplicitAny": "error"
			},
			"performance": {
				"useTopLevelRegex": "off",
				"noBarrelFile": "off"
			},
			"nursery": {}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["next", "next/*", "next-auth", "next-auth/*", "next-themes"],
										"message": "SPA must not import Next.js / NextAuth / next-themes."
									},
									{
										"group": [
											"@lyre/api/services/*",
											"@lyre/api/handlers/*",
											"@lyre/api/runtime",
											"@lyre/api/db/*"
										],
										"message": "Server-only @lyre/api subpaths must not leak into the browser bundle."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/.wrangler",
			"!**/build",
			"!apps/macos",
			"!apps/api/static",
			"!apps/web/dist",
			"!apps/web/src/components/ui",
			"!**/*.d.ts",
			"!**/generated",
			"!bun.lock",
			"!.superset"
		]
	}
}
